{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp>=1.1.3,<2",
        "mcp-server-fetch"
      ]
    },
    "yfinance": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Alex2Yang97/yahoo-finance-mcp",
        "--with",
        "mcp>=1.1.3,<2",
        "yahoo-finance-mcp"
      ]
    }
  }
}
